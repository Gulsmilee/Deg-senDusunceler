@{
    ViewData["Title"] = "Şifremi Unuttum";
    Layout = "_Layout";
}

<div class="container">
    <div class="auth-card">

        <div class="text-center mb-4">
            <svg width="48" height="48" viewBox="0 0 26 26" fill="none">
                <ellipse cx="13" cy="13" rx="6" ry="6" fill="#a78bfa" opacity="0.95"/>
                <ellipse cx="13" cy="13" rx="11.5" ry="4" stroke="#c4b5fd"
                         stroke-width="1.3" fill="none" opacity="0.6"/>
            </svg>
            <h1 class="auth-title mt-2">Şifreni sıfırla</h1>
            <p class="auth-sub">Kayıtlı emailini gir, yeni şifre belirle</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-danger-saturn mb-3">@ViewBag.Error</div>
        }

        <form method="post" asp-action="ResetPassword">
            <div class="mb-4">
                <label class="form-label">Email</label>
                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="Kayıtlı email adresin"
                       required />
            </div>
            <button type="submit" class="btn-saturn w-100">Devam Et</button>
        </form>

        <p class="text-center mt-3" style="color:var(--text-muted);font-size:13px;">
            <a asp-action="Login"
               style="color:var(--accent-light);text-decoration:none;">
                ← Giriş sayfasına dön
            </a>
        </p>

    </div>
</div>