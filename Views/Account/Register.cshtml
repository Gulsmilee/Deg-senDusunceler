@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_Layout";
}

<div class="container">
    <div class="auth-card">

        <div class="text-center mb-4">
            <svg width="48" height="48" viewBox="0 0 26 26" fill="none">
                <ellipse cx="13" cy="13" rx="6" ry="6" fill="#a78bfa" opacity="0.95"/>
                <ellipse cx="13" cy="13" rx="11.5" ry="4" stroke="#c4b5fd"
                         stroke-width="1.3" fill="none" opacity="0.6"/>
            </svg>
            <h1 class="auth-title mt-2">Kapsülünü oluştur</h1>
            <p class="auth-sub">Düşüncelerini evrene bırakmaya hazır mısın?</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-danger-saturn mb-3">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Register">

            <div class="mb-3">
                <label class="form-label">Ad Soyad</label>
                <input type="text"
                       name="fullName"
                       class="form-control"
                       placeholder="Adın Soyadın"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="ornek@mail.com"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">Şifre</label>
                <input type="password"
                       name="password"
                       id="passwordInput"
                       class="form-control"
                       placeholder="En az 6 karakter"
                       required />
                <!-- JS şifre güç barı -->
                <div class="strength-bar mt-2">
                    <div class="strength-fill" id="strengthFill"></div>
                </div>
                <span class="strength-label" id="strengthLabel"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Şifre Tekrar</label>
                <input type="password"
                       name="passwordConfirm"
                       id="passwordConfirm"
                       class="form-control"
                       placeholder="••••••••"
                       required />
                <span id="matchLabel"
                      style="font-size:10px;margin-top:3px;display:block"></span>
            </div>

            <button type="submit" class="btn-saturn w-100">Kapsülü Oluştur</button>
        </form>

        <p class="text-center mt-3" style="color:var(--text-muted);font-size:13px;">
            Zaten hesabın var mı?
            <a asp-action="Login"
               style="color:var(--accent-light);text-decoration:none;">
                Giriş yap
            </a>
        </p>

    </div>
</div>

@section Scripts {
<script>
    // ── Şifre güç barı ──
    const passwordInput = document.getElementById('passwordInput');
    const strengthFill  = document.getElementById('strengthFill');
    const strengthLabel = document.getElementById('strengthLabel');
    const confirmInput  = document.getElementById('passwordConfirm');
    const matchLabel    = document.getElementById('matchLabel');

    passwordInput.addEventListener('keyup', function () {
        const val = this.value;
        let strength = 0;
        let label = '';
        let color = '';

        if (val.length >= 6)  strength++;
        if (val.length >= 10) strength++;
        if (/[A-Z]/.test(val)) strength++;   // büyük harf var mı
        if (/[0-9]/.test(val)) strength++;   // rakam var mı
        if (/[^A-Za-z0-9]/.test(val)) strength++; // özel karakter var mı

        if (strength <= 1) {
            label = 'Zayıf'; color = '#f87171';
        } else if (strength <= 3) {
            label = 'Orta'; color = '#fbbf24';
        } else {
            label = 'Güçlü'; color = '#34d399';
        }

        // Barın genişliği ve rengi güce göre değişiyor
        strengthFill.style.width  = (strength * 20) + '%';
        strengthFill.style.background = color;
        strengthLabel.textContent = val.length > 0 ? label : '';
        strengthLabel.style.color = color;
    });

    // ── Şifre eşleşme kontrolü ──
    confirmInput.addEventListener('keyup', function () {
        if (this.value === passwordInput.value) {
            matchLabel.textContent = '✓ Şifreler eşleşiyor';
            matchLabel.style.color = '#34d399';
        } else {
            matchLabel.textContent = '✗ Şifreler eşleşmiyor';
            matchLabel.style.color = '#f87171';
        }
    });
</script>
}