@{
    ViewData["Title"] = "Yeni Şifre";
    Layout = "_Layout";
}

<div class="container">
    <div class="auth-card">

        <div class="text-center mb-4">
            <svg width="48" height="48" viewBox="0 0 26 26" fill="none">
                <ellipse cx="13" cy="13" rx="6" ry="6" fill="#a78bfa" opacity="0.95"/>
                <ellipse cx="13" cy="13" rx="11.5" ry="4" stroke="#c4b5fd"
                         stroke-width="1.3" fill="none" opacity="0.6"/>
            </svg>
            <h1 class="auth-title mt-2">Yeni şifreni belirle</h1>
            <p class="auth-sub">@ViewBag.ResetEmail</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert-danger-saturn mb-3">@ViewBag.Error</div>
        }

        <form method="post" asp-action="NewPassword">

            <!-- Email gizli alan olarak taşınıyor -->
            <input type="hidden" name="email" value="@ViewBag.ResetEmail" />

            <div class="mb-3">
                <label class="form-label">Yeni Şifre</label>
                <input type="password"
                       name="newPassword"
                       id="newPasswordInput"
                       class="form-control"
                       placeholder="En az 6 karakter"
                       required />
                <div class="strength-bar mt-2">
                    <div class="strength-fill" id="strengthFill"></div>
                </div>
                <span class="strength-label" id="strengthLabel"></span>
            </div>

            <div class="mb-4">
                <label class="form-label">Yeni Şifre Tekrar</label>
                <input type="password"
                       name="newPasswordConfirm"
                       id="newPasswordConfirm"
                       class="form-control"
                       placeholder="••••••••"
                       required />
                <span id="matchLabel"
                      style="font-size:10px;margin-top:3px;display:block"></span>
            </div>

            <button type="submit" class="btn-saturn w-100">Şifremi Güncelle</button>
        </form>

    </div>
</div>

@section Scripts {
<script>
    const np  = document.getElementById('newPasswordInput');
    const nc  = document.getElementById('newPasswordConfirm');
    const sf  = document.getElementById('strengthFill');
    const sl  = document.getElementById('strengthLabel');
    const ml  = document.getElementById('matchLabel');

    np.addEventListener('keyup', function () {
        const val = this.value;
        let strength = 0;
        if (val.length >= 6)  strength++;
        if (val.length >= 10) strength++;
        if (/[A-Z]/.test(val)) strength++;
        if (/[0-9]/.test(val)) strength++;
        if (/[^A-Za-z0-9]/.test(val)) strength++;

        const colors = ['','#f87171','#f87171','#fbbf24','#34d399','#34d399'];
        const labels = ['','Zayıf','Zayıf','Orta','Güçlü','Güçlü'];
        sf.style.width = (strength * 20) + '%';
        sf.style.background = colors[strength] || '#f87171';
        sl.textContent = val.length > 0 ? labels[strength] : '';
        sl.style.color = colors[strength] || '#f87171';
    });

    nc.addEventListener('keyup', function () {
        if (this.value === np.value) {
            ml.textContent = '✓ Şifreler eşleşiyor';
            ml.style.color = '#34d399';
        } else {
            ml.textContent = '✗ Şifreler eşleşmiyor';
            ml.style.color = '#f87171';
        }
    });
</script>
}