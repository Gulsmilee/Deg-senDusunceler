@model DegisenDusunceler.Models.Memory
@{
    ViewData["Title"] = Model != null ? "Anıyı Düzenle" : "Yeni Anı";
    Layout = "_Layout";
    bool isEdit = Model != null;
}

<div class="container py-4">
    <div class="create-card mx-auto">

        <h2 class="mb-1" style="color:var(--text-main);font-size:18px;font-weight:600">
            @(isEdit ? "✦ Anıyı Düzenle" : "✦ Yeni Anı")
        </h2>
        <p style="color:var(--text-muted);font-size:12px;margin-bottom:1.5rem">
            @(isEdit ? "Düşüncelerini güncelle" : "Bugün ne hissettirdi sana evren?")
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="alert-danger-saturn mb-3">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Create" asp-route-id="@(isEdit ? Model!.Id : null)">

            <div class="mb-3">
                <label class="form-label">Başlık</label>
                <input type="text"
                       name="title"
                       class="form-control"
                       placeholder="Anına bir başlık ver..."
                       value="@(isEdit ? Model!.Title : "")"
                       required />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Anı
                    <span style="float:right;color:var(--text-dim)" id="wordCount">0 kelime</span>
                </label>
                <textarea name="content"
                          id="contentArea"
                          class="form-control"
                          rows="8"
                          placeholder="Düşüncelerini buraya yaz..."
                          required>@(isEdit ? Model!.Content : "")</textarea>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label">Tarih — Saat</label>
                    <!-- JS ile otomatik dolacak, kullanıcı görmek için readonly -->
                    <input type="text"
                           name="createdAt"
                           id="dateInput"
                           class="form-control"
                           readonly />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Görünürlük</label>
                    <div class="d-flex gap-3 mt-2">
                        <label class="radio-label">
                            <input type="radio" name="isPublic" value="true"
                                   @(isEdit && Model!.IsPublic ? "checked" : !isEdit ? "checked" : "") />
                            <span>🌌 Herkese Açık</span>
                        </label>
                        <label class="radio-label">
                            <input type="radio" name="isPublic" value="false"
                                   @(isEdit && !Model!.IsPublic ? "checked" : "") />
                            <span>🔒 Gizli</span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn-saturn">
                    @(isEdit ? "Güncelle" : "♄ Kapsüle kilitle")
                </button>
                <a asp-action="MyCapsule" class="btn-saturn-outline text-decoration-none">
                    İptal
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
    // ── Tarih ve saati otomatik doldur ──
    const now = new Date();
    const pad = n => String(n).padStart(2, '0');
    const formatted =
        `${pad(now.getDate())}.${pad(now.getMonth()+1)}.${now.getFullYear()} ` +
        `${pad(now.getHours())}:${pad(now.getMinutes())}`;
    document.getElementById('dateInput').value = formatted;

    // ── Kelime sayacı ──
    const area  = document.getElementById('contentArea');
    const count = document.getElementById('wordCount');

    function updateCount() {
        const words = area.value.trim().split(/\s+/).filter(w => w.length > 0);
        count.textContent = words.length + ' kelime';
    }

    area.addEventListener('keyup', updateCount);
    updateCount(); // sayfa açılışında başlangıç değeri
</script>
}