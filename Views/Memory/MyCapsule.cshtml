@model List<DegisenDusunceler.Models.Memory>
@{
    ViewData["Title"] = "Kapsülüm";
    Layout = "_Layout";
    var userName = Context.Session.GetString("UserFullName") ?? "";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1" style="color:var(--text-main);font-size:20px;font-weight:600">
                ♄ Kapsülüm
            </h2>
            <p style="color:var(--text-muted);font-size:13px;margin:0">
                @userName · @Model.Count anı
            </p>
        </div>
        <a asp-action="Create"
           class="btn-saturn text-decoration-none">
            + Yeni anı
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <svg width="56" height="56" viewBox="0 0 26 26" fill="none" class="mb-3">
                <ellipse cx="13" cy="13" rx="6" ry="6" fill="#a78bfa" opacity="0.4"/>
                <ellipse cx="13" cy="13" rx="11.5" ry="4" stroke="#c4b5fd"
                         stroke-width="1.3" fill="none" opacity="0.3"/>
            </svg>
            <p style="color:var(--text-muted)">Henüz hiç anı yazmadın.</p>
            <a asp-action="Create" class="btn-saturn text-decoration-none">
                İlk anını yaz
            </a>
        </div>
    }
    else
    {
        <!-- Anı tablosu -->
        <div class="table-responsive">
            <table class="table capsule-table">
                <thead>
                    <tr>
                        <th>Başlık</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th>Görüntülenme</th>
                        <th>Tepkiler</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var memory in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@memory.Id"
                                   class="memory-link">
                                    @memory.Title
                                </a>
                            </td>
                            <td style="color:var(--text-muted);font-size:12px">
                                @memory.CreatedAt.ToString("dd MMM yyyy, HH:mm")
                            </td>
                            <td>
                                @if (memory.IsPublic)
                                {
                                    <span class="badge-open">Açık</span>
                                }
                                else
                                {
                                    <span class="badge-private">Gizli</span>
                                }
                            </td>
                            <td style="color:var(--text-muted);font-size:12px">
                                👁 @memory.ViewCount
                            </td>
                            <td style="color:var(--text-muted);font-size:12px">
                                @memory.Reactions.Count tepki
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="Create" asp-route-id="@memory.Id"
                                       class="table-btn-edit">Düzenle</a>

                                    <form method="post" asp-action="Delete"
                                          onsubmit="return confirm('Bu anıyı silmek istediğine emin misin?')">
                                        <input type="hidden" name="id" value="@memory.Id" />
                                        <button type="submit" class="table-btn-delete">Sil</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>